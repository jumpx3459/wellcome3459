# Supabase 프로젝트 설정 (Supabase 대시보드 > Project Settings > API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # 서버 전용, 절대 공개 저장소에 커밋하지 마세요

# 웹 푸시 알림 (알라미처럼 기기에 직접 알림 — 카카오 알림톡 불필요)
# 아래 명령으로 키 쌍을 생성하세요: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# 정부지원금 정보 (기업마당 오픈 API)
# 발급: https://www.bizinfo.go.kr → 정책정보 > 정책정보 개방 > 지원사업정보 API > 사용신청
BIZINFO_API_KEY=

# 관리자 화면(/admin) 로그인 — 계정별 비밀번호는 admin_users 테이블에 저장하고,
# 여기 이 값은 로그인 성공 시 발급하는 세션 토큰 서명용입니다 (아무 긴 무작위 문자열).
# 예: openssl rand -hex 32
# ADMIN_PASSWORD는 더 이상 코드에서 읽지 않습니다(admin_users로 대체) — 남아 있어도
# 무해하지만 지워도 됩니다.
ADMIN_SESSION_SECRET=

# 2026-09-28: (선택) 다른 최고관리자가 이 번호의 관리자 계정을 해제/강등하지
# 못하게 보호 — 최고관리자끼리는 원래 동등한 권한이라, 새로 임명한 최고관리자가
# 원래 계정을 해제할 수 있는 문제를 막기 위함. 본인만 자신을 해제/강등 가능.
# 비워두면 이 보호는 그냥 꺼짐. 형식은 01012345678 / 010-1234-5678 / +821012345678
# 어느 쪽이든 됨 — 숫자만 비교함 (src/app/api/admin/admins/route.ts의 normalizePhone).
FOUNDER_ADMIN_PHONE=

# SEO/사이트맵용 실제 배포 주소 (커스텀 도메인 연결 후 그 주소로 바꿔주세요)
NEXT_PUBLIC_SITE_URL=https://dumpingjumping.vercel.app

# 구글 애드센스 (승인 계정 있을 때만 입력 — 비워두면 광고 자리에 준비중 표시만 나옵니다)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# JUMP X 인증 브릿지 ("JUMP X에서 입찰 참여하기" 버튼, src/app/api/jumpx-bridge)
# JUMP X와 덤핑점핑은 별개의 Supabase 프로젝트라 로그인 세션을 직접 공유할 수
# 없어서, 전화번호만 미리 채워서 JUMP X 쪽 SMS 인증으로 넘기는 방식을 씁니다.
JUMPX_BRIDGE_URL=https://<jumpx-project-ref>.supabase.co/functions/v1/bridge-issue-ticket
JUMPX_BRIDGE_SHARED_SECRET=   # JUMP X 프로젝트의 BRIDGE_SHARED_SECRET과 동일한 값으로 설정
JUMPX_ORIGIN=https://jumpx.co.kr
